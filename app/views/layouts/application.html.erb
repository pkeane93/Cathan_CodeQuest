<!DOCTYPE html>
<html>
  <head>
    <title>CathanCodeQuest</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Import Tailwind CSS %>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <%# Import DaisyUI CSS %>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <%# Import Tabler.io Icons %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

    <%# Favicon %>
    <%= favicon_link_tag "Cathan_logo_03_bg_black.png" %>
  </head>

  <body class="bg-gray-900 text-white container min-h-screen w-full mx-auto pb-40">
    <header>
      <%= render "shared/navbar" if show_navbar? %>
    </header>

    <main id="main-content">
      <%= yield %>
    </main>

  </body>
</html>
