<div class="flex flex-col gap-10 items-center pt-40">
  <% if policy(Post.new).new? %>
    <%= form_with(model: [@post], class: "p-5 flex flex-col gap-2", local: true, html: { multipart: true }) do |f| %>

        <div class="border-l border-white pl-4 mb-15">
          <h3 class="text-xl"> Modify title </h3>
            <%= f.text_field :title, class: "mb-2 text-2xl p-2 text-center w-full focus:outline-none border-none bg-gray-800 rounded-md" %>
            <%= f.text_field :subtitle, rows: 2, placeholder: "Write it's Content..", class: "mb-2 text-2xl p-2 text-center w-full focus:outline-none border-none bg-gray-800 rounded-md" %>
            <%= f.label :image, "Upload an Image", class: "font-semibold" %>
            <%= f.file_field :image, class: "border p-2 rounded w-full" %>
        </div>

      <!-- Blocks -->
      <div class="border-l border-white pl-4 mb-15">
        <h3 class="text-xl">Modify content</h3>

        <%= f.fields_for :blocks do |bf| %>
          <div class="flex justify-end mb-2">
            <%= link_to(post_block_path(@post, bf.object), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this article?" }, class:"py-1 px-2 rounded-full hover:scale-112 bg-white text-black text-2xl") do%>
              <i class="ti ti-trash"></i>
            <%end%>
          </div>
          <div class="mb-8">
            <%= bf.text_field :blocktitle, class: "mb-2 text-2xl p-2 text-center w-full focus:outline-none border-none bg-gray-800 rounded-md" %>
            <%= bf.text_area :blocktext, rows: 4, class: "text-2xl p-2 text-center w-full focus:outline-none border-none bg-gray-800 rounded-md" %>
            <%= bf.label :image, "Upload block image", class: "font-semibold" %>
            <%= bf.file_field :image, class: "border p-2 rounded w-full" %>
          </div>
        <% end %>
      </div>


      <%= f.submit "Update", class: "p-3 border border-white rounded-md cursor-pointer" %>

    <% end %>
  <% end %>
</div>
