<div class="flex flex-col gap-10 items-center pt-40">
  <%# Edit Form %>
    <% if policy(Post.new).new? %>
      <div>
        <%= form_with(model: [@post], class: "p-5 flex flex-col gap-2", local: true, html: { multipart: true }) do |f| %>
          <div class="mb-8">
            <%= f.text_field :title, class: "text-2xl p-2 text-center w-full focus:outline-none border-none placeholder:italic bg-gray-800 rounded-md" %>
          </div>

          <div class="mb-8">
            <%= f.text_field :subtitle, rows: 2, placeholder: "Write it's Content..", class: "text-2xl p-2 text-center w-full focus:outline-none border-none placeholder:italic bg-gray-800 rounded-md" %>
          </div>

          <div>
            <%= f.label :image, "Upload an Image", class: "font-semibold" %>
            <%= f.file_field :image, class: "border p-2 rounded w-full" %>
          </div>

          <%= f.submit "Update", class: "p-3 border border-white rounded-md cursor-pointer" %>
        <% end %>
      </div>

      <div>
        <% @post.blocks.each do |block| %>
          <%= form_with(model: [@post], class: "p-5 flex flex-col gap-2", local: true, html: { multipart: true }) do |f| %>
          <div class="mb-8">
            <%= f.text_field :blocktitle, class: "text-2xl p-2 text-center w-full focus:outline-none border-none placeholder:italic bg-gray-800 rounded-md" %>
          </div>

          <div class="mb-8">
            <%= f.text_area :blocktext, rows: 2, placeholder: "Write it's Content..", class: "text-2xl p-2 text-center w-full focus:outline-none border-none placeholder:italic bg-gray-800 rounded-md" %>
          </div>

          <%= f.submit "Update", class: "p-3 border border-white rounded-md cursor-pointer" %>
        <% end %>
        <% end %>
      </div>

    <% end %>
</div>
