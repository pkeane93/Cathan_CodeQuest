<div class="h-[30vh] sm:h-[39vh] md:h-[49vh] w-full border-b border-gray-600 mb-15">
  <%= image_tag("banner.jpg", alt: "The warrior Cathan on his quest to finding ruby gems", class:"w-full h-full object-cover [object-position:50%_46%]") %>
</div>


<%# Flexed Container %>
<div data-controller="dropdown" class="px-6 grid gap-15 grid-cols-1 lg:grid-cols-4 lg:px-15">
  <%# Left side %>
  <div class="lg:col-span-1">
      <%# Admin add card %>
      <div class="w-full">
        <% if policy(Post.new).new? %>
          <%= link_to(new_post_path, class:"w-full mb-15 h-40 bg-opacity-100 border border-dashed border-gray-600 hover:border-white transition-colors duration-300 ease-in-out rounded-sm flex items-center justify-center group") do%>
            <i class="ti ti-plus text-6xl text-gray-600 group-hover:text-white transition-colors duration-300 ease-in-out"></i>
          <%end%>
        <% end %>
      </div>

    <%# Filters %>
      <div class="w-full p-5 border border-gray-600 rounded-sm">

        <%# Filter: Sort By %>
        <div class="py-10 px-10">
          <h3>SORT BY</h3>
          <select data-action="change->dropdown#change" class="w-full py-4 text-center mt-8 border border-gray-600 rounded-md appearance-none hover:border-white transition-colors duration-300 ease-in-out">
            <option class="bg-gray-900" value="recent">Recent</option>
            <option value="oldest" class="bg-gray-900">Oldest</option>
            <%# <option value="popular" class="bg-gray-900">Most popular</option> %>
          </select>
        </div>

        <%# Filter: Elements %>
        <%# <div class="py-10 px-10 border-t border-gray-600">
          <h3>ELEMENTS</h3>
        </div> %>

      </div>
  </div>


  <%# Cards %>
  <ul data-dropdown-target="cards" class="lg:col-span-3 grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <%@posts.each do |post|%>
      <li id="post-<%= post.id %>" class="relative group">
        <%# Delete Post %>
        <% if policy(Post.new).new? %>
          <div class="absolute bottom-2 w-full flex justify-center">

            <%= link_to(post_path(post), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this article?" }, class:"py-2 px-3 rounded-full hover:scale-112 bg-white text-black text-2xl") do%>
              <i class="ti ti-trash"></i>
            <%end %>

            <%= button_to( post.published? ? "🟢" : "🔴", toggle_published_post_path(post), method: :patch, class:"hover:scale-112 text-3xl") %>

          </div>
        <%end%>

        <%# Card %>
          <%= link_to(post_path(post)) do%>
            <div class="h-full bg-opacity-100 text-white border border-gray-600 rounded-sm group-hover:border-white transition-colors duration-300 ease-in-out">

              <figure>
                <%= image_tag(post.image.present? ? post.image  : "placeholder.jpg", alt: "blog post image", class:"border-b border-gray-600 rounded-t-sm group-hover:border-white transition-colors duration-300 ease-in-out") %>
              </figure>

              <div class="card-body">
                <h2 class="card-title">
                  <%= post.title %>
                </h2>

                <p>
                  <%= post.subtitle%>
                </p>

                <%# <div class="card-actions justify-start">
                  <div class="badge badge-outline rounded-sm">
                    Display categories
                  </div>
                </div> %>
              </div>

            </div>
          <%end%>
      </li>
    <%end%>
  </ul>

</div>
