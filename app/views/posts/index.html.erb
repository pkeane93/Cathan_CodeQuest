<div class="h-90 w-full border-b border-gray-600 mb-20">
  <%= image_tag("banner.jpg", alt: "banner of a ruby gem", class:"w-full h-full object-cover [object-position:50%_46%]") %>
</div>

<%# Flexed Container %>
<div data-controller="dropdown" class="flex gap-15 items-start px-15">

  <%# Filters %>
  <div class="w-1/4 border border-gray-600 rounded-sm">

    <%# Filter: Sort By %>
    <div class="py-10 px-10 border-b border-gray-600">
      <h3>SORT BY</h3>
      <div class="relative inline-block w-48">
        <select data-action="change->dropdown#change" class="py-5 px-20 mt-8 border border-gray-600 rounded-md appearance-none hover:border-white transition-colors duration-300 ease-in-out">
          <option class="bg-gray-900" value="recent">Recent</option>
          <option value="oldest" class="bg-gray-900">Oldest</option>
          <%# <option value="popular" class="bg-gray-900">Most popular</option> %>
        </select>
      </div>
    </div>

    <%# Filter: Elements %>
    <%# <div class="py-10 px-10">
      <h3>ELEMENTS</h3>
    </div> %>

  </div>

  <%# Cards %>
  <ul data-dropdown-target="cards" class="w-3/4 gap-5 flex flex-wrap">
    <li id="post-0">
      <% if policy(Post.new).new? %>
        <%= link_to(new_post_path, class:"w-75 h-full bg-opacity-100 border border-dashed border-gray-600 hover:border-white transition-colors duration-300 ease-in-out rounded-sm flex items-center justify-center group") do%>
          <i class="ti ti-plus text-6xl text-gray-600 group-hover:text-white transition-colors duration-300 ease-in-out"></i>
        <%end%>
      <% end %>
    </li>

    <%@posts.each do |post|%>
      <li id="post-<%= post.id %>" class="relative group">
        <%# Delete Post %>
        <% if policy(Post.new).new? %>
          <%= link_to(post_path(post), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this article?" }, class:"py-2 px-3 absolute top-3 right-3 rounded-full hover:scale-112 bg-white text-black text-2xl") do%>
            <i class="ti ti-trash"></i>
          <%end%>
        <%end%>

        <%# Card %>
        <%= link_to(post_path(post)) do%>
          <div class="w-75 h-full bg-opacity-100 text-white border border-gray-600 rounded-sm group-hover:border-white transition-colors duration-300 ease-in-out">

            <figure>
              <%= image_tag("placeholder.jpg", alt: "blog post", class:"border-b border-gray-600 rounded-t-md group-hover:border-white transition-colors duration-300 ease-in-out") %>
            </figure>

            <div class="card-body">
              <h2 class="card-title">
                <%= post.title %>
              </h2>

              <p>
                <%= post.subtitle%>
              </p>

              <%# <div class="card-actions justify-start">
                <div class="badge badge-outline rounded-sm">
                  Display categories
                </div>
              </div> %>
            </div>

          </div>
        <%end%>

      </li>
    <%end%>
  </ul>

</div>
