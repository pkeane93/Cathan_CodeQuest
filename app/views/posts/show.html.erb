
<div class="flex flex-col gap-10 items-center pt-40">

  <h1 class="text-5xl"><%= @post.title %></h1>
  <h3 class="text-xl"><%= @post.subtitle %></h3>
  <div>
    <ul class="flex gap-3">
      <li class="font-bold border border-gray-600 rounded-md px-2 py-1 text-sm">CATEGORY</li>
      <li class="font-bold border border-gray-600 rounded-md px-2 py-1 text-sm">CATEGORY</li>
    </ul>
  </div>

  <%# Displayed Content %>
  <div class="w-3/5 items-left">
    <% @post.blocks.each_with_index do |block, index|%>
      <% previous_block = @post.blocks[index - 1] if index > 0 %>
      <% if block.blocktitle.present? %>
        <div class="px-28 my-15">
          <% if index > 0 && !previous_block.image.attached? %>
            <hr class="opacity-50 mb-15">
          <% end %>
          <h2 class="fond-bold text-2xl"> <%= block.blocktitle %> </h2>
          <p class="my-10 opacity-70"> <%= block.blocktext %> </p>
        </div>
      <% end %>
      <% if block.image.attached? %>
        <%= image_tag(block.image, class:"w-full h-full object-cover")%>
      <% end %>
    <% end %>
  </div>

  <%# Admin Form %>
    <% if policy(Post.new).new? %>
      <div>
        <%= form_with(model: [@post, @block], class: "p-5 flex flex-col gap-2", local: true, html: { multipart: true }) do |f| %>
          <div class="mb-8">
            <%= f.text_field :blocktitle, placeholder: "Write the Paragraph Title..", class: "text-2xl p-2 text-center w-full focus:outline-none border-none placeholder:italic bg-gray-800 rounded-md" %>
          </div>

          <div class="mb-8">
            <%= f.text_area :blocktext, rows: 2, placeholder: "Write it's Content..", class: "text-2xl p-2 text-center w-full focus:outline-none border-none placeholder:italic bg-gray-800 rounded-md" %>
          </div>

          <div>
            <%= f.label :image, "Upload an Image", class: "font-semibold" %>
            <%= f.file_field :image, class: "border p-2 rounded w-full" %>
          </div>

          <%= f.submit "Add Paragraph", class: "p-3 border border-white rounded-md cursor-pointer" %>
        <% end %>
      </div>
    <% end %>
</div>
