<%# Footer %>
<div id="footer" class="w-full mt-20">
  <hr class="opacity-50">
  <%# Top %>
  <div id="footer_top" class="px-10 py-10 flex flex-col lg:flex-row gap-8 lg:gap-0 lg:justify-between items-center lg:items-center text-xl lg:text-2xl font-semibold">

    <div>
      <h2>Keep exploring topics</h2>
    </div>

    <div class="flex items-center gap-10">
      <p>Share this blog</p>

      <%= link_to("https://twitter.com/intent/tweet?url=https%3A%2F%2Fcathancodequest.sliplane.app%2F&text=Check+out+this+blog!",
            class: "border opacity-70 rounded-full p-4 hover:bg-white hover:text-gray-700 transition-colors duration-300 ease-in-out",
            target: "_blank") do %>

        <i class="text-4xl ti ti-brand-x"></i>
      <% end %>

        <%= link_to("https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fcathancodequest.sliplane.app%2F",
            class: "border opacity-70 rounded-full p-4 hover:bg-white hover:text-gray-700 transition-colors duration-300 ease-in-out",
            target: "_blank") do %>

        <i class="text-4xl ti ti-brand-facebook"></i>
      <% end %>

        <%= link_to("https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Fcathancodequest.sliplane.app%2F",
            class: "border opacity-70 rounded-full p-4 hover:bg-white hover:text-gray-700 transition-colors duration-300 ease-in-out",
            target: "_blank") do %>

        <i class="text-4xl ti ti-brand-linkedin"></i>
      <% end %>
    </div>

  </div>

  <hr class="opacity-50">
  <%# Middle %>
  <% if show_footer_middle? %>
    <div id="footer_mid" class="px-10 py-10 text-2xl items-center font-semibold">
      <h2 class="mb-5">More articles</h2>
      <div class="grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 justify-items-center">

        <%@random_posts.each do |post|%>
          <ul>
            <%= link_to(post_path(post)) do%>
              <li class ="group">
                <div class="w-full max-w-sm bg-opacity-100 text-white border border-gray-600 rounded-sm group-hover:border-white transition-colors duration-300 ease-in-out">
                  <figure>
                    <%= image_tag("placeholder.jpg", alt: "blog post", class:"border-b border-gray-600 rounded-t-md group-hover:border-white transition-colors duration-300 ease-in-out") %>
                  </figure>
                  <div class="card-body">
                    <h2 class="card-title">
                      <%= post.title %>
                      <%# <div class="badge badge-secondary">NEW</div> %>
                    </h2>
                    <p>Add description to schema table</p>
                    <div class="card-actions justify-start">
                      <div class="badge badge-outline rounded-sm">Display categories</div>
                    </div>
                  </div>
                </div>
              </li>
            <%end%>
          </ul>
        <%end%>
      </div>
    </div>
  <hr class="opacity-50">
  <% end %>

  <%# Bottom %>
  <div id="footer_bot" class="px-6 sm:px-10 py-10 flex flex-col sm:flex-row gap-6 sm:gap-0 sm:justify-between items-start sm:items-center">

    <div>
      <a href="https://pkeane93.github.io/portfolio_page/" target= "_blank">
        <div class="pr-5 flex gap-5 items-center border border-gray-900 rounded-l-full hover:border-white transition-colors duration-300 ease-in-out">

          <figure class="h-13 w-13 rounded-full overflow-hidden ">
            <%= image_tag("PkeBaliAvatar.jpg", class:"object-cover h-full w-full ") %>
          </figure>

          <div>
            <p class="font-bold">Pierre K.</p>
            <p class="opacity-70">Full Stack Software Engineer</p>
          </div>

        </div>
      </a>
    </div>

    <div class="flex items-center gap-10">
      <%= link_to("ARTICLES", posts_path)%>
      <%= link_to("ABOUT", about_path)%>
    </div>

  </div>

</div>
